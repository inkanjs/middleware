  "license": "MIT",
  "author": "Vensin (https://github.com/vxnsin)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkanjs/middleware.git",
    "directory": "packages/etag"
  },
  "keywords": [
    "inkan",
    "etag",
    "conditional-request",
    "if-none-match",
