{
  "name": "@inkanjs/proxy",
  "version": "0.1.0",
  "description": "A streaming reverse proxy for inkan: a prefix or one route handed on to a server behind it, on node:http alone.",
  "type": "module",
  "license": "MIT",
  "author": "Vensin (https://github.com/vxnsin)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkanjs/middleware.git",
    "directory": "packages/proxy"
  },
  "keywords": [
    "inkan",
    "proxy",
    "reverse-proxy",
    "gateway",
    "http-proxy",
    "x-forwarded-for"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@vxnsin/inkan": ">=0.7.0"
  },
  "devDependencies": {
    "@vxnsin/inkan": "file:../../../inkan-release-0.7"
  },
  "scripts": {
    "test": "node --test test.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
