{
  "name": "@inkanjs/auth",
  "version": "0.2.0",
  "description": "Authentication for inkan without dependencies: sessions, JWTs, API keys, passwords, TOTP and OAuth on node:crypto alone.",
  "type": "module",
  "license": "MIT",
  "author": "Vensin (https://github.com/vxnsin)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkanjs/middleware.git",
    "directory": "packages/auth"
  },
  "keywords": [
    "inkan",
    "auth",
    "jwt",
    "jwks",
    "oauth",
    "oidc",
    "pkce",
    "totp",
    "scrypt",
    "session",
    "csrf",
    "refresh-token"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@vxnsin/inkan": ">=0.8.0 <1.0.0"
  },
  "devDependencies": {
    "@vxnsin/inkan": "file:../../../inkan-release-0.8"
  },
  "scripts": {
    "test": "node --import ../../scripts/no-deprecations.js --test \"test/*.test.ts\""
  },
  "publishConfig": {
    "access": "public"
  }
}
